APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Phase 1 default is 5 MB. The technical doc shows 10 MB as an example;
# change this number if you want a different cap. The API reads it at startup.
MAX_UPLOAD_SIZE_MB=5

# POST /api/upload validates a CSV in memory and does not save it.
# POST /api/documents analyses and saves CSV, PDF, and DOCX files under backend/data.

# Server-side Gemini video analysis. Leave the key blank until you create one
# in Google AI Studio. Never put this value in frontend code or in a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_VIDEO_SIZE_MB=100
GEMINI_FILE_TIMEOUT_SECONDS=180

# Phase 3 only. Leave these unset until authentication and PostgreSQL are added.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/creatorlens
# CLERK_JWKS_URL=
# CLERK_ISSUER=
MAX_DOCUMENT_SIZE_MB=15

# Official YouTube Data API key. Server-side only. Never put this in frontend code.
YOUTUBE_API_KEY=
YOUTUBE_CACHE_SECONDS=21600

# Later creator connection. Leave blank until OAuth is completed.
# Impressions, click-through rate, and audience retention stay unavailable without it.
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
